# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Local agent tooling state
.serena/
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# pennyblack needs no virtualenv (stdlib only), but do not commit one if a
# contributor makes one anyway.
.venv/

# Never commit credentials or a local send log. These live in
# ~/.dbhq/pennyblack/ and should never be inside a repo, but belt and braces.
config.json
sent.jsonl

# The record of posted letters: names, postal addresses and a copy of each
# letter. This repository is public, so a letter posted from a checkout of it
# must never be committed. The whole folder, not only sent.jsonl, because the
# PDFs sit beside it.
.pennyblack/
*.pem
.env
